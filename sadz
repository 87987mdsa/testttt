local function getHRP()
    local char = lp.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function tpTo(pos)
    local hrp = getHRP()
    if not hrp or not pos then return false end
    hrp.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
    return true
end

local function tpSell()
    tpTo(sellzonePart.Position)
    task.wait(0.8)
end

local function getItemPosition(item)
    local part = item:FindFirstChildWhichIsA("BasePart") or item.PrimaryPart or item:FindFirstChild("Handle")
    return part and part.Position
end

local function lookAtPart(targetPart, distancia)
    local hrp = getHRP()
    if not hrp or not targetPart then return end

    distancia = distancia or 4

    local targetPos = targetPart.Position
    local hrpPos = hrp.Position

    local dir = (hrpPos - targetPos).Unit
    local desiredPos = targetPos + dir * distancia

    hrp.CFrame = CFrame.new(desiredPos)
    task.wait()

    local cam = workspace.CurrentCamera
    cam.CFrame = CFrame.new(cam.CFrame.Position, targetPos)
end

