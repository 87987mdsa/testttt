local function abrirCajas()
    local itemsToOpen = {}
    
    for _, caja in pairs(cajasFolder:GetChildren()) do
        if not caja:IsA("Folder") then
            table.insert(itemsToOpen, caja)
        end
    end
    
    for _, caja in ipairs(itemsToOpen) do
        Event:FireServer("\x92\a\x91\xC8\x01", {caja})
        task.wait(0.05)
    end
    
    task.wait(0.5)
end

local function lootear()
    if not hayTools() then
        endRunSequence()
        return false
    end

    while not isBackpackFull() do
        if areHandsFull() then
            tpSell()
            task.wait(0.2)
        end

        local found = false
        local itemsToLoot = {}
        
        for _, item in ipairs(itemsFolder:GetChildren()) do
            if (item:IsA("Tool") or item:IsA("Model") or item:FindFirstChildOfClass("Tool")) and isItemDeseado(item) then
                table.insert(itemsToLoot, item)
            end
        end
        
        for _, item in ipairs(itemsToLoot) do
            if isBackpackFull() then break end

            if areHandsFull() then
                tpSell()
                task.wait(0.2)
                break
            end

            local pos = getItemPosition(item)
            if pos then
                local hrp = getHRP()
                if hrp and (hrp.Position - pos).Magnitude > 15 then
                    tpTo(pos)
                    task.wait(0.3)
                end
                if not areHandsFull() and item.Parent == itemsFolder then
                    Event:FireServer("\x92\a\x91\xC8\x01", {item})
                    task.wait(0.25)
                    found = true
                end
            end
        end

        if not found then break end
        if not hayTools() then
            endRunSequence()
            return false
        end
    end

    tpSell()
    return true
end

local function useGiftBoxIfFound()
    local ok, bottom = pcall(function()
        return lp.PlayerGui.Main.HomePage.Bottom
    end)
    if not ok then return false end
    
    local keyMap = {
        [1] = Enum.KeyCode.One,
        [2] = Enum.KeyCode.Two,
        [3] = Enum.KeyCode.Three,
        [4] = Enum.KeyCode.Four
    }
    
    for i = 1, 4 do
        local slot = bottom:FindFirstChild(tostring(i))
        if slot then
            local itemDetails = slot:FindFirstChild("ItemDetails")
            if itemDetails then
                local itemName = itemDetails:FindFirstChild("ItemName")
                if itemName and itemName.Text == "Gift Box" then
                    local keyCode = keyMap[i]
                    VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
                    task.wait(0.05)
                    VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
                    
                    task.wait(0.15)
                    
                    Event:FireServer("\x923\x91\xCBA\xDAO5_\xD9u\x98")
                    
                    return true
                end
            end
        end
    end
    return false
end

