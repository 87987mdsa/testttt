local function areHandsFull()
    local ok, hf = pcall(function()
        return lp.PlayerGui.Main.HomePage.HandsFull
    end)
    return ok and hf and hf.Visible
end

local function isAlarmRed()
    local ok, alarm = pcall(function()
        return lp.PlayerGui.Main.HomePage.Countdown.Main.Alarm
    end)
    if not ok or not alarm then return false end
    local c = alarm.ImageColor3
    return c.R > 0.9 and c.G < 0.5 and c.B < 0.5
end

local function isBackpackFull()
    local ok, bottom = pcall(function()
        return lp.PlayerGui.Main.HomePage.Bottom
    end)
    if not ok then return false end
    local filled = 0
    for i = 1, 4 do
        local slot = bottom:FindFirstChild(tostring(i))
        if slot then
            local tool = slot:FindFirstChild("Tool")
            if tool and tool:IsA("ImageLabel")
                and tool.Image ~= ""
                and tool.Image ~= "rbxasset://textures/ui/GuiImagePlaceholder.png" then
                filled += 1
            end
        end
    end
    return filled >= 4
end

local function hayTools()
    for _, item in ipairs(itemsFolder:GetChildren()) do
        if (item:IsA("Tool") or item:IsA("Model") or item:FindFirstChildOfClass("Tool")) and isItemDeseado(item) then
            return true
        end
    end
    return false
end

local function parseNumber(str)
    if not str then return 0 end
    str = str:gsub("[^%d]", "")
    return tonumber(str) or 0
end

local function isGoalCompleted()
    local ok, goalText = pcall(function()
        return lp.PlayerGui.Main.HomePage.Goal.GoalProgressBar.GoalText
    end)
    if not ok then return false end

    local cashNum = parseNumber(goalText.Cash.Text)
    local goalNum = parseNumber(goalText.Goal.Text)
    return cashNum >= goalNum
end

