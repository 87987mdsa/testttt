local itemMonsterTimers = {}  
local DETECT_DISTANCE = 5
local FAKE_ITEM_TIME = 3

local function isItemFake(item)
    local pos = item:FindFirstChildWhichIsA("BasePart") and item:FindFirstChildWhichIsA("BasePart").Position
    
    if not pos then return false end
    
    for _, monster in ipairs(monstersFolder:GetChildren()) do
        local monsterPart = monster:FindFirstChildWhichIsA("BasePart")
        if monsterPart then
            local dist = (pos - monsterPart.Position).Magnitude
            if dist <= DETECT_DISTANCE then
                itemMonsterTimers[item] = tick()
                return true
            end
        end
    end
    
    local lastMonsterTime = itemMonsterTimers[item]
    if lastMonsterTime and (tick() - lastMonsterTime) > FAKE_ITEM_TIME then
        itemMonsterTimers[item] = nil
        return true
    end
    
    return false
end

itemsFolder.ChildRemoved:Connect(function(child)
    itemMonsterTimers[child] = nil
end)

local function isItemDeseado(item)
    if isItemFake(item) then
        return false
    end
    
    local ok, itemNameLabel = pcall(function()
        local folder = item:FindFirstChild("Folder")
        if not folder then return nil end

        local interactable = folder:FindFirstChild("Interactable")
        if not interactable then return nil end

        local lootUI = interactable:FindFirstChild("LootUI")
        if not lootUI then return nil end

        local frame = lootUI:FindFirstChild("Frame")
        if not frame then return nil end

        return frame:FindFirstChild("ItemName")
    end)

    if not ok or not itemNameLabel or not itemNameLabel:IsA("TextLabel") then
        return true
    end

    local name = itemNameLabel.Text or ""

    for _, bad in ipairs(itemsNoDeseados) do
        if name == bad then
            return false
        end
    end

    return true
end

